{
  "host": "mikrotik",
  "title": "MikroTik",
  "fields": [
    {
      "label": "Uptime",
      "field": "uptime",
      "format": "display_uptime"
    },
    {
      "label": "Free memory",
      "field": "free_memory",
      "format": "display_memory"
    }
  ],
  "rules": [
    {
      "when": {
        "field": "latest_version",
        "operator": "versionGreaterThan",
        "value": {
          "field": "version"
        }
      },
      "then": {
        "receiver": "client",
        "method": "addNotification",
        "argument": ["Software update available:\nVersion {{latest_version}} ({{update_channel}})",
          "install-routeros-update"]
      }
    },
    {
      "when": {
        "field": "upgrade_firmware",
        "operator": "versionGreaterThan",
        "value": {
          "field": "current_firmware"
        }
      },
      "then": {
        "receiver": "client",
        "method": "addNotification",
        "argument": [
          "RouterBOOT firmware update available:\nVersion {{upgrade_firmware}}",
          "install-routerboot-update"
        ]
      }
    }
  ],
  "order": 10
}
