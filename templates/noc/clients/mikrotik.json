{
  "host": "mikrotik",
  "title": "MikroTik",
  "fields": [
    {
      "label": "Uptime",
      "value":
      {
        "field": "uptime",
        "formatter": "display_duration"
      }
    },
    {
      "label": "Free memory",
      "value":
      {
        "field": "free_memory",
        "formatter": "display_memory"
      }
    }
  ],
  "rules": [
    {
      "when": {
        "field": "latest_version",
        "operator": "versionGreaterThan",
        "value": {
          "field": "version"
        }
      },
      "then": {
        "receiver": "client",
        "method": "addNotification",
        "argument": {
          "text": [
            "Software update available:\nVersion ",
            {
              "field": "latest_version"
            },
            " (",
            {
              "field": "update_channel"
            },
            ")"
          ],
          "resolution": "install-routeros-update"
        }
      }
    },
    {
      "when": {
        "field": "upgrade_firmware",
        "operator": "versionGreaterThan",
        "value": {
          "field": "current_firmware"
        }
      },
      "then": {
        "receiver": "client",
        "method": "addNotification",
        "argument": {
          "text": [
            "RouterBOOT firmware update available:\nVersion ",
            {
              "field": "upgrade_firmware"
            }
          ],
          "resolution": "install-routerboot-update"
        }
      }
    },
    {
      "when": {
        "field": "wan_lease_remaining",
        "operator": "lessThan",
        "value": 5553
      },
      "then": {
        "receiver": "client",
        "method": "addNotification",
        "argument": {
          "text": [
            "Remaining lease time: ",
            {
              "field": "wan_lease_remaining",
              "formatter": "display_duration"
            }
          ],
          "resolution": "reacquire-wan-dhcp-lease"
        }
      }
    }
  ],
  "order": 10
}
