# BRD-032: Provision trusted RouterOS update action with safety catch

:local scriptName "noc-install-routeros-update"
:local source "/system package update install"
:local scriptId [/system script find name=$scriptName]

:if ([:len $scriptId] > 0) do={
    /system script set $scriptId \
        comment="Install available RouterOS update from trusted NOC action" \
        policy=read,write,reboot,policy \
        dont-require-permissions=yes \
        source=$source
} else={
    /system script add \
        name=$scriptName \
        comment="Install available RouterOS update from trusted NOC action" \
        policy=read,write,reboot,policy \
        dont-require-permissions=yes \
        source=$source
}
