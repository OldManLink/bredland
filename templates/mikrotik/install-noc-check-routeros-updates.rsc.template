# BRD-032: Provision daily RouterOS update check for NOC

:local scriptName "noc-check-routeros-updates"
:local schedulerName "noc-check-routeros-updates"

:local scriptId [/system script find name=$scriptName]

:if ([:len $scriptId] > 0) do={
    /system script set $scriptId \
        comment="Refresh cached RouterOS update status for NOC" \
        policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon \
        dont-require-permissions=no \
        source="/system package update check-for-updates"
} else={
    /system script add \
        name=$scriptName \
        comment="Refresh cached RouterOS update status for NOC" \
        policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon \
        dont-require-permissions=no \
        source="/system package update check-for-updates"
}

:local schedulerId [/system scheduler find name=$schedulerName]

:if ([:len $schedulerId] > 0) do={
    /system scheduler set $schedulerId \
        comment="Run daily RouterOS update check for NOC" \
        start-date=2026-07-10 \
        start-time=04:15:00 \
        interval=1d \
        on-event=$scriptName \
        policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon
} else={
    /system scheduler add \
        name=$schedulerName \
        comment="Run daily RouterOS update check for NOC" \
        start-date=2026-07-10 \
        start-time=04:15:00 \
        interval=1d \
        on-event=$scriptName \
        policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon
}
