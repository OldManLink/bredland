# Permanent harmless trusted-action integration probe.

:local scriptName "noc-trusted-action-probe"

:if ([:len [/system script find name=$scriptName]] > 0) do={
    /system script remove [find name=$scriptName]
}

/system script add \
    name=$scriptName \
    dont-require-permissions=yes \
    source={
        :log info "[NOC-TRUSTED-PROBE] trusted action probe started"
        :delay 10s
        :log info "[NOC-TRUSTED-PROBE] trusted action probe completed"
    }
